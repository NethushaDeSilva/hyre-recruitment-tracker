# Firebase web config — TEMPLATE.
# 1. Copy this file to a new file named  .env.local
# 2. Paste your values from Firebase Console → Project settings (gear icon)
#    → "Your apps" → Web app → SDK setup and configuration → Config.
# 3. IMPORTANT: after editing .env.local you MUST stop and restart `npm run dev`
#    — Vite only reads env vars at startup.
#
# .env.local is git-ignored, so your keys never get committed.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — "Filter with AI" candidate screening. The URL of your Cloudflare
# Worker (see /worker). Leave blank to hide the AI feature.
VITE_AI_FILTER_URL=
