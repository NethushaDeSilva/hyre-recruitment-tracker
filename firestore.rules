rules_version = '2';

// Hyre Firestore security rules — FULL LOCKDOWN.
//
// Design principles:
//  1. Nothing is readable or writable without being signed in.
//  2. A user's role (users/{uid}.role) is the basis for every permission — so a
//     user must NEVER be able to grant themselves a staff role. Self-serve
//     accounts are always Candidates; staff roles are provisioned out-of-band
//     (Firebase console or scripts/provision-staff.mjs) and can't change here.
//  3. WS1 identity split: a person's CV/profile lives ONCE in /candidates
//     (keyed by email); each vacancy they apply to is its own /applications
//     doc. Applicants can create only THEIR OWN application, only into
//     "applied" — no self-promotion to hired, no forged review data.
//  4. Staff writes are gated by STAGE OWNERSHIP (mirrors src/lib/stages.js) and
//     the audit trail (history[]) is append-only — entries can never be
//     removed or truncated, so a rejection can't be quietly erased.
//  5. Applicants read only their own rows (by uid or verified email); staff read
//     the whole collection. The client MUST constrain candidate list queries to
//     match (see src/data/store.js).
//
// NOTE: comments[] is intentionally staff-mutable (the product lets a reviewer
// delete their own note before confirming a move); rules can't cheaply prove
// which array element a caller removed. history[] is the tamper-evident record.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The requester's role, read from their profile doc ("" if none).
    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "";
    }
    function isStaff() {
      return myRole() in ['HR', 'Interviewer', 'Management'];
    }
    function isRecruiter() {
      return myRole() in ['HR', 'Management'];
    }

    // A deletion lock closes the vacancy before any dependent rows are removed.
    function positionAvailable(id) {
      return exists(/databases/$(database)/documents/positions/$(id))
        && !get(/databases/$(database)/documents/positions/$(id)).data.get('deleting', false);
    }
    function deletingPosition(id) {
      return isRecruiter()
        && exists(/databases/$(database)/documents/positions/$(id))
        && get(/databases/$(database)/documents/positions/$(id)).data.get('deleting', false);
    }
    function optionalPositionAvailable(data) {
      return data.get('positionId', '') == '' || positionAvailable(data.positionId);
    }

    function newPositionClaim(id) {
      let data = request.resource.data;
      let code = data.identityCode;
      let number = data.identitySequence;
      return code is string && code.matches('^[A-Z0-9]{1,5}$')
        && number is int && number > 0
        && id == code + '-' + (number < 10 ? '0' : '') + string(number)
        && getAfter(/databases/$(database)/documents/positionSequences/$(code)).data.next == number
        && number == (exists(/databases/$(database)/documents/positionSequences/$(code))
          ? get(/databases/$(database)/documents/positionSequences/$(code)).data.next : 0) + 1;
    }

    match /positionSequences/{code} {
      allow read: if isStaff();
      allow create: if isRecruiter() && code.matches('^[A-Z0-9]{1,5}$')
        && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next == 1;
      allow update: if isRecruiter() && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int && request.resource.data.next == resource.data.next + 1;
      allow delete: if false;
    }

    // Permanent identity registry. The full final vacancy survives deletion here.
    match /positionArchive/{id} {
      allow read: if isStaff();
      allow create: if isRecruiter() && (
        (newPositionClaim(id) && request.resource.data.recordState == 'Active'
          && getAfter(/databases/$(database)/documents/positions/$(id)).data.identitySequence == request.resource.data.identitySequence)
        || (deletingPosition(id) && request.resource.data.recordState == 'Deleted'));
      allow update: if deletingPosition(id) && request.resource.data.recordState == 'Deleted';
      allow delete: if false;
    }

    // Which role owns (may advance/reject a candidate sitting in) a stage.
    // Mirrors STAGES[...].owner in src/lib/stages.js.
    function stageOwner(stage) {
      return stage in ['applied', 'screening', 'hold'] ? 'HR'
           : stage in ['dept', 'interview', 'interview2'] ? 'Interviewer'
           : stage == 'final' ? 'Management'
           : ''; // hired / rejected are terminal — no owner
    }
    // May the caller act on a candidate currently in `stage`?
    // Management can act on any stage; otherwise the caller must own it.
    function ownsStage(stage) {
      return myRole() == 'Management' || myRole() == stageOwner(stage);
    }

    // history[] may only grow — never shrink or be dropped. Tolerates docs that
    // have no history field yet (older seed data).
    function historyAppendOnly() {
      return !('history' in resource.data)
        || (('history' in request.resource.data)
            && request.resource.data.history.size() >= resource.data.history.size());
    }

    function activeCrossApplication(a) {
      return !(a.stage in ['rejected', 'withdrawn', 'hired'])
        && !(a.get('status', '') in ['Rejected', 'Withdrawn', 'Hired', 'rejected', 'withdrawn', 'hired']);
    }
    function validCrossRejection() {
      let old = resource.data;
      let next = request.resource.data;
      let audit = next.crossRejection;
      let sourcePath = /databases/$(database)/documents/applications/$(audit.sourceApplicationId);
      let source = get(sourcePath).data;
      let comments = old.get('comments', []);
      let history = old.get('history', []);
      let feedback = next.comments[comments.size()];
      let event = next.history[history.size()];
      return myRole() in ['HR', 'Interviewer']
        && activeCrossApplication(old) && activeCrossApplication(source)
        && source.stage in ['screening', 'dept', 'interview', 'interview2', 'final']
        && source.personId is string && source.personId.size() > 0
        && source.personId == old.personId && audit.personId == old.personId
        && source.positionId != old.positionId && positionAvailable(source.positionId)
        && getAfter(sourcePath).data == source
        && next.diff(old).affectedKeys().hasOnly(['stage', 'status', 'comments', 'history', 'rejection', 'crossRejection'])
        && next.stage == 'rejected'
        && (!('status' in old) ? !('status' in next) : next.status == 'Rejected')
        && audit.keys().hasOnly(['sourceApplicationId', 'personId', 'byUid', 'at', 'committedAt'])
        && audit.byUid == request.auth.uid && audit.committedAt == request.time && audit.at is int
        && feedback.keys().hasOnly(['byUid', 'by', 'byRole', 'at', 'text', 'score', 'stage', 'sourceApplicationId', 'type'])
        && feedback.byUid == request.auth.uid && feedback.byRole == myRole()
        && feedback.at == audit.at && feedback.stage == old.stage
        && feedback.type == 'cross_reject' && feedback.sourceApplicationId == audit.sourceApplicationId
        && feedback.text is string && feedback.text.matches('[\\s\\S]*[^\\s][\\s\\S]*')
        && feedback.score is number && feedback.score >= 0 && feedback.score <= 100
        && next.comments == comments.concat([feedback])
        && next.history == history.concat([event])
        && event == {'byUid': feedback.byUid, 'by': feedback.by, 'byRole': feedback.byRole, 'at': feedback.at,
          'type': 'reject', 'from': old.stage, 'to': 'rejected', 'reason': 'Candidate chose another position',
          'comment': feedback.text, 'score': feedback.score, 'sourceApplicationId': audit.sourceApplicationId}
        && next.rejection == {'byUid': feedback.byUid, 'by': feedback.by, 'byRole': feedback.byRole, 'at': feedback.at,
          'reason': 'Candidate chose another position', 'comment': feedback.text, 'score': feedback.score, 'stage': old.stage};
    }

    function validPreferenceRecord() {
      let p = request.resource.data;
      let source = get(/databases/$(database)/documents/applications/$(p.sourceApplicationId)).data;
      return myRole() == 'HR'
        && p.keys().hasOnly(['personId','sourceApplicationId','choice','selectedApplicationId','selectedPositionTitle','applicationIds','byUid','by','at','note','createdAt'])
        && p.byUid == request.auth.uid && p.by is string && p.at is int
        && p.createdAt == request.time && p.note is string
        && p.personId is string && p.personId.size() > 0 && source.personId == p.personId
        && activeCrossApplication(source) && source.stage in ['screening','dept','interview','interview2','final']
        && positionAvailable(source.positionId)
        && p.applicationIds is list && p.applicationIds.size() >= 2 && p.applicationIds.size() <= 50
        && p.sourceApplicationId in p.applicationIds
        && p.choice in ['both','one','undecided']
        && (p.choice != 'one' ? p.selectedApplicationId == '' : (
          p.selectedApplicationId in p.applicationIds
          && getAfter(/databases/$(database)/documents/applications/$(p.selectedApplicationId)).data.personId == p.personId
          && activeCrossApplication(getAfter(/databases/$(database)/documents/applications/$(p.selectedApplicationId)).data)));
    }
    function validPreferenceWithdrawal(id) {
      let old = resource.data;
      let next = request.resource.data;
      let event = next.withdrawal;
      let path = /databases/$(database)/documents/candidatePreferences/$(event.preferenceId);
      let preference = getAfter(path).data;
      let kept = getAfter(/databases/$(database)/documents/applications/$(preference.selectedApplicationId)).data;
      return myRole() == 'HR' && !exists(path)
        && preference.choice == 'one' && preference.byUid == request.auth.uid
        && preference.personId == old.personId && kept.personId == old.personId
        && id in preference.applicationIds && id != preference.selectedApplicationId
        && kept.positionId != old.positionId && activeCrossApplication(kept)
        && activeCrossApplication(old) && next.stage == 'withdrawn'
        && next.diff(old).affectedKeys().hasOnly(['stage','status','withdrawal','history'])
        && (!('status' in old) ? !('status' in next) : next.status == 'Withdrawn')
        && event == {'type':'withdraw','from':old.stage,'to':'withdrawn','reason':'Candidate preference',
          'comment':preference.note,'preferenceId':event.preferenceId,'selectedApplicationId':preference.selectedApplicationId,
          'byUid':preference.byUid,'by':preference.by,'byRole':'HR','at':preference.at}
        && next.history == old.get('history', []).concat([event]);
    }
    match /candidatePreferences/{id} {
      allow read: if isStaff();
      allow create: if validPreferenceRecord();
      allow update, delete: if false;
    }

    // HR Screening is an assigned live interview. UID and the saved booking
    // are checked at commit time, not trusted from the browser's role alone.
    function screeningPermit(positionId, permit) {
      let position = get(/databases/$(database)/documents/positions/$(positionId)).data;
      let team = position.get('stageAssignees', {}).get('screening', []);
      let booking = get(/databases/$(database)/documents/interviews/$(permit.interviewId)).data;
      return myRole() == 'HR'
        && permit.assignmentIndex is int && permit.assignmentIndex >= 0
        && (team is list ? (permit.assignmentIndex < team.size() && team[permit.assignmentIndex].uid == request.auth.uid)
          : (team is map && permit.assignmentIndex == 0 && team.uid == request.auth.uid))
        && booking.kind == 'stage_assignment' && booking.positionId == positionId
        && booking.stageId == 'screening' && booking.interviewerId == request.auth.uid
        && booking.status == 'confirmed' && booking.scheduledAt is timestamp
        && booking.durationMs is number && booking.durationMs > 0;
    }
    function screeningProgressAllowed() {
      let old = resource.data;
      let next = request.resource.data;
      let progressing = !(next.stage in ['applied', 'screening', 'rejected', 'withdrawn']);
      return (!next.diff(old).affectedKeys().hasAny(['screeningAuthorization'])
          || (old.stage == 'screening' && screeningPermit(old.positionId, next.screeningAuthorization)))
        && (old.stage != 'screening' || !progressing || screeningPermit(old.positionId, next.screeningAuthorization))
        && (old.stage != 'applied' || next.stage in ['applied', 'rejected', 'withdrawn'] || myRole() == 'HR');
    }

    // --- user profiles ---
    match /users/{uid} {
      allow read: if signedIn();
      // Create your own profile as a Candidate only. (Staff docs are provisioned
      // out-of-band, so this create path is never used for staff.)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'Candidate';
      // Update your own profile, but you can NEVER change your own role. Your
      // readable User ID (userId) is write-ONCE: it may be minted when absent
      // (the app self-heals it on first sign-in) but can never be altered after.
      // WS8 §8.1/§8.3: `domain`/`levels` (interviewer specialisation) live on
      // this doc rather than a separate `interviewers` collection (CLAUDE.md
      // WS8 §8.3 deviation note) — self-write is allowed the same way name/
      // avatarColor/title already are; nothing about them is security-critical
      // the way `role` is, so they don't need their own narrower rule.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && (!('userId' in resource.data)
                        || request.resource.data.userId == resource.data.userId);
      allow delete: if false;
    }

    // --- WS8 declared availability (one per staff member, self-declared) ---
    // A person's own schedule claim — never inferred, never written by anyone
    // but them. HR gets read-all (needed for the calendar view, §8.2a) but NOT
    // write access to someone else's declaration: HR editing another person's
    // availability would make it HR's claim wearing that person's name, which
    // is indistinguishable from fabrication if it's ever wrong. HR's real
    // power is the manual override on the BOOKING itself (§15), a separate,
    // clearly-attributed action — not silently rewriting someone's calendar.
    match /availability/{staffUid} {
      allow read: if isStaff();
      // isStaff() here, not just a uid match — a Candidate has an auth.uid
      // too, and without this check they could write themselves a doc at
      // availability/{their-own-uid}. Meaningless data (nothing ever reads a
      // candidate's own uid out of this collection) but it's exactly the kind
      // of stray write the rest of this ruleset is written to prevent by
      // construction rather than by nothing-happens-to-read-it luck.
      allow create, update: if isStaff() && request.auth.uid == staffUid
                    && request.resource.data.timeZone is string
                    && request.resource.data.timeZone.size() > 0;
      allow delete: if false; // re-declaring supersedes; deleting would just create a false `unknown` gap
    }

    // --- Weekly availability TEMPLATE (a person's own recurring week) -----
    // Deliberately a SEPARATE collection from /availability above — same
    // ownership shape (read: any staff; write: only your own uid), but a
    // different document shape (a permanent weekly template, not a dated
    // declaration with an expiry), so it gets its own match block rather
    // than overloading the one above with two incompatible schemas.
    match /weeklyAvailability/{staffUid} {
      allow read: if isStaff();
      allow create, update: if isStaff() && request.auth.uid == staffUid
                    && request.resource.data.updatedByUid == staffUid
                    && request.resource.data.days is map;
      allow delete: if false; // same reasoning as /availability — re-saving supersedes
    }

    // --- WS8 Part C interviews (automated requests + booked interviews) ---
    // create: staff only (the assignment trigger or HR's manual override, §15
    // — both run under a staff session; an Interviewer can trigger one too,
    // since advancing a candidate out of an Interviewer-owned stage is a
    // normal action for that role — see applications' ownsStage() precedent).
    //
    // READ and UPDATE's broad branch is isRecruiter() (HR/Management), NOT
    // isStaff(). This was a real bug, found live: isStaff() includes the
    // Interviewer role, so `isStaff() || (narrow interviewer-self check)`
    // let isStaff() short-circuit true for ANY interviewer on ANY OTHER
    // interviewer's request — the narrow branch below was correctly written
    // but dead code, silently bypassed by the broad OR in front of it. An
    // Interviewer must only ever touch a request where they ARE the current
    // interviewerId, through the narrow, mechanically-constrained path — full
    // staff-grade access to this collection belongs to HR/Management only.
    //
    // SECOND ENCOUNTER, 2026-09-19: the exact same isStaff() widening was
    // proposed again, this time to satisfy commitInterviewChanges()'s
    // unfiltered getDocs(collection(db,"interviews")) call in
    // src/lib/interviewPersistence.js — its cross-position conflict check
    // (bookingConflict) needs visibility into bookings that don't belong to
    // the caller. Investigated whether the read could instead be scoped to
    // where("interviewerId","==",request.auth.uid): it cannot, cleanly — see
    // the dated note above the `interviews` match block below for why, and
    // report this conversation for the two options put to the Product Owner.
    // Do not re-propose isStaff() here a third time without reading this.
    // update, isRecruiter(): full access — HR's override, marking completed.
    // update, the currently-requested interviewer, responding to THEIR OWN
    // pending request — exactly two shapes, nothing else:
    //   ACCEPT   — only `status` changes, to 'confirmed'.
    //   DECLINE  — mechanically advances via `rankedInfo`, a uid-KEYED map
    //     written once at creation: rankedInfo[uid].nextUid says who follows
    //     that person in the ranking (or null if nobody does). The new
    //     interviewerId must equal rankedInfo[OLD interviewerId].nextUid —
    //     the interviewer can only reveal a value someone else already wrote,
    //     never name their own replacement.
    //     IMPORTANT: this is deliberately a KEYED map lookup, not indexing
    //     into rankedCandidates by position. An earlier version tried
    //     `rankedCandidates[currentRankIndex].uid` and, verified LIVE against
    //     these deployed rules, that did NOT actually constrain the write —
    //     a forged reassignment to an arbitrary uid was wrongly allowed
    //     (scratch-ws8/verify-cascade-rules.mjs documents the failing and
    //     passing runs). Keyed map access mirrors the pattern this ruleset
    //     already trusts elsewhere (myRole() reading a doc by uid) and was
    //     re-verified live to correctly reject a forged value before this
    //     shipped — do not revert to positional indexing.
    //     A second live finding: BOTH rankedInfo[uid].nextUid AND
    //     interviewerId use "" (never `null`) to mark "nobody" — comparing
    //     either to `null` did not evaluate as a straightforward equality
    //     check when tested live (top-level or nested; the exact cause
    //     wasn't isolated further once removing `null` entirely fixed it
    //     both places). A real Firebase uid is never "", so the sentinel can
    //     never be mistaken for a real assignment. The app's own read layer
    //     (mapInterviewDoc in store.js) converts "" back to `null` for
    //     consumers — this sentinel is a rules-evaluation workaround, not a
    //     concept that should leak into the rest of the codebase.
    function scheduleRevisionAdvanced() {
      let path = /databases/$(database)/documents/counters/interviewSchedule;
      let before = exists(path) ? get(path).data.next : 0;
      return getAfter(path).data.next == before + 1;
    }
    // 2026-09-19 — READ STAYS isRecruiter()-OR-SELF, NOT isStaff(). Investigated
    // scoping commitInterviewChanges()'s unfiltered read (src/lib/interviewPersistence.js)
    // to where("interviewerId","==",request.auth.uid) instead of widening this
    // rule. Firestore requires an unfiltered collection query to be provably
    // satisfied by the rule for EVERY possible returned document, so a scoped
    // query only works if every legitimate read genuinely only ever needs the
    // caller's own docs — and it doesn't: respondToInterviewRequest()'s DECLINE
    // path also conflict-checks the PROPOSED NEXT interviewer (a different
    // uid, read from the current request's own rankedInfo) before handing off,
    // so the query needs a second party's bookings, not just the caller's own.
    // A self-scoped query cannot return that document at all under a
    // self-scoped rule. Reported to the Product Owner rather than widened
    // silently a second time; see the two options above this match block.
    match /interviews/{interviewId} {
      allow read: if isRecruiter()
        || (signedIn() && resource.data.interviewerId == request.auth.uid);
      allow create: if isStaff() && scheduleRevisionAdvanced() && positionAvailable(request.resource.data.positionId);
      allow update: if scheduleRevisionAdvanced() && positionAvailable(resource.data.positionId)
        && request.resource.data.positionId == resource.data.positionId
        && (isRecruiter()
        || (signedIn() && resource.data.interviewerId == request.auth.uid
            && resource.data.status == 'pending_confirmation'
            && (
                 (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                  && request.resource.data.status == 'confirmed')
                 ||
                 (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'interviewerId', 'requestedAt', 'respondedBy'])
                  && request.resource.data.respondedBy.size() == resource.data.respondedBy.size() + 1
                  && (
                       (resource.data.rankedInfo[resource.data.interviewerId].nextUid != ''
                        && request.resource.data.interviewerId == resource.data.rankedInfo[resource.data.interviewerId].nextUid
                        && request.resource.data.status == 'pending_confirmation')
                       ||
                       (request.resource.data.interviewerId == ''
                        && request.resource.data.status == 'needs_attention')
                     )
                 )
               )));
      allow delete: if deletingPosition(resource.data.positionId);
    }

    // --- positions ---
    //  read:   any signed-in user
    //  create: recruiters (HR is the recruitment authority; vacancies open directly)
    //  update: recruiters may edit details/stages and change status (close/reopen)
    //  delete: recruiters (HR owns the pipeline post role-swap; Management retained)
    match /positions/{id} {
      // Staff manage every status (draft/open/closed); anyone else may only
      // read an Open vacancy directly by id — otherwise a candidate who knows
      // or guesses a draft/closed position's id can read it despite never
      // seeing it in any listing (WS1: "draft and closed never leak" — a
      // client-side query filter alone doesn't enforce that, this does; CLAUDE.md
      // 6.7 R6).
      allow read: if isStaff() || (signedIn() && resource.data.status == 'Open');
      allow create: if isRecruiter() && newPositionClaim(id)
        && !exists(/databases/$(database)/documents/positionArchive/$(id))
        && getAfter(/databases/$(database)/documents/positionArchive/$(id)).data.recordState == 'Active';
      allow update: if !resource.data.get('deleting', false)
        && request.resource.data.get('identityCode', '') == resource.data.get('identityCode', '')
        && request.resource.data.get('identitySequence', 0) == resource.data.get('identitySequence', 0)
        && (isRecruiter()
        // Any staff member may close out a requisition as part of hiring a
        // candidate into it (hireCandidate() in src/data/store.js) — the stage
        // whose owner triggers the "hired" transition isn't always HR/Management
        // (e.g. a short pipeline where an Interviewer-owned stage feeds straight
        // into Hired). Scoped tightly: only hiredCount/status may change,
        // hiredCount only ever advances by exactly one, and status may only
        // become "Closed" — never anything else — through this path.
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiredCount', 'status'])
            && request.resource.data.hiredCount == resource.data.get('hiredCount', 0) + 1
            && (request.resource.data.status == resource.data.status || request.resource.data.status == 'Closed')));
      allow delete: if isRecruiter() && resource.data.get('deleting', false)
        && getAfter(/databases/$(database)/documents/positionArchive/$(id)).data.recordState == 'Deleted';
    }

    // --- sequence counters (e.g. counters/candidates.next) ---
    // Hands out unique, monotonically-increasing candidate numbers. Any signed-in
    // user may read it and claim the next number, but the value can only ever go
    // UP (and only the `next` field exists), so numbers can't be reused or forged
    // downward. Uniqueness is guaranteed by the client using a transaction.
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && (id != 'interviewSchedule' || (isStaff() && request.resource.data.next == 1)) && (id != 'positionsV2' || (isRecruiter() && request.resource.data.next == 1))
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= 1;
      allow update: if signedIn() && (id != 'interviewSchedule' || (isStaff() && request.resource.data.next == resource.data.next + 1)) && (id != 'positionsV2' || (isRecruiter() && request.resource.data.next == resource.data.next + 1))
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next > resource.data.next;
      allow delete: if false;
    }

    // --- candidates (IDENTITY — one per person, keyed on lowercased email) ---
    // WS1: a person's email, phone, CV and parsed profile live ONCE here, shared
    // across every vacancy they apply to (see /applications below). This is
    // deliberately permissive on the `email` field itself (mirrors the pre-split
    // rule, which never cross-checked the typed email against the verified
    // auth email either) — `submittedByUid`, when present, is the real anchor.
    match /candidates/{id} {
      // read: staff → all; a person → only their own identity record.
      // The `!exists()` clause is load-bearing, not defensive dressing: a
      // FIRST-TIME applicant's own upsertIdentityInTx() does a tx.get() on
      // this exact path BEFORE the document exists (check-before-create), and
      // without it `resource.data.submittedByUid` dereferences a null
      // `resource` — Firestore treats that evaluation error as denied, which
      // blocked every brand-new candidate's very first application outright
      // (found live; existing candidate docs all predate this path or were
      // created by staff, whose isStaff() branch never touches `resource`).
      // Safe to allow unconditionally: a nonexistent document has no data to
      // leak.
      allow read: if isStaff()
        || (signedIn() && (
              !exists(/databases/$(database)/documents/candidates/$(id))
              || resource.data.submittedByUid == request.auth.uid
              || resource.data.email == request.auth.token.email));

      // create: staff (HR quick-add, WS5 email intake) or a signed-in person
      // creating their OWN identity — if submittedByUid is set at all, it must
      // be their own uid, so nobody can create an identity claiming to be
      // someone else's account.
      allow create: if isStaff()
        || (signedIn()
            && (!('submittedByUid' in request.resource.data)
                || request.resource.data.submittedByUid == request.auth.uid));

      // update: staff (enrich/correct a profile, WS5 merge) or the owning
      // person (WS4's "confirm what we read from your CV" step) — the anchors
      // (email, candidateId) can never change once minted.
      allow update: if isStaff()
        || (signedIn()
            && (resource.data.submittedByUid == request.auth.uid
                || resource.data.email == request.auth.token.email)
            && request.resource.data.email == resource.data.email
            && request.resource.data.candidateId == resource.data.candidateId);

      // delete: never — identity persists regardless of how many applications
      // come and go, or whether the person is eventually hired.
      allow delete: if false;
    }

    // --- applications (PIPELINE — one per person per vacancy) ---
    match /applications/{id} {
      // read: staff → all; applicant → only their own (by uid or verified email).
      allow read: if isStaff()
        || (signedIn() && (
              resource.data.submittedByUid == request.auth.uid
              || resource.data.email == request.auth.token.email));

      // create: staff add anyone; an applicant creates only their own
      // application, only into "applied", with no forged review payload.
      allow create: if positionAvailable(request.resource.data.positionId) && (isStaff()
        || (signedIn()
            && request.resource.data.submittedByUid == request.auth.uid
            && request.resource.data.stage == 'applied'
            && request.resource.data.source == 'Self-applied'
            && (!('comments' in request.resource.data)
                || request.resource.data.comments.size() == 0)));

      // update: staff only, history append-only, and either
      //   (a) no stage change  → a comment / profile edit (any staff), or
      //   (b) a stage change   → the caller must own the current stage, or
      //   (c) HR reinstating a rejected candidate from the talent pool
      //       (rejected → applied). ONLY HR may reconsider — not Management.
      allow update: if positionAvailable(resource.data.positionId)
        && request.resource.data.positionId == resource.data.positionId
        && request.resource.data.get('personId', '') == resource.data.get('personId', '')
        && isStaff() && historyAppendOnly() && screeningProgressAllowed()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['crossRejection'])
        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['withdrawal'])
          || (request.resource.data.stage == 'withdrawn' && resource.data.stage != 'withdrawn')
          ? validPreferenceWithdrawal(id)
          : (request.resource.data.stage == resource.data.stage
            || (resource.data.stage != 'withdrawn' && ownsStage(resource.data.stage))
            || (resource.data.stage == 'rejected' && request.resource.data.stage == 'applied' && myRole() == 'HR')));

      // delete: explicit position cleanup, or as part of a HIRE transfer — a stage owner (or Management)
      // removes the application the instant it's written into `employees`.
      // Rejected applications otherwise remain in the talent pool.
      allow delete: if deletingPosition(resource.data.positionId) || (isStaff()
        && !(resource.data.stage in ['rejected', 'withdrawn'])
        && ownsStage(resource.data.stage)
        && (resource.data.stage != 'screening' || screeningPermit(resource.data.positionId, resource.data.screeningAuthorization)));
    }

    // --- employees (HIRED people) ---
    // The moment an application reaches "hired" it's MOVED out of /applications
    // and written here as a full snapshot (see hireCandidate() in
    // src/data/store.js), keyed by a readable employee ID (e.g.
    // employees/SE-SNE-0001). The person's /candidates identity record is left
    // untouched — it isn't deleted just because they were hired. Same read
    // scoping as applications: staff see everyone; a person sees only their own.
    match /employees/{id} {
      allow read: if isStaff()
        || (signedIn() && (
              resource.data.submittedByUid == request.auth.uid
              || resource.data.email == request.auth.token.email));

      // create: staff only, and only a well-formed HIRED record (this is the
      // destination of a hire — never a self-serve write).
      allow create: if isStaff() && positionAvailable(request.resource.data.positionId)
        && request.resource.data.stage == 'hired'
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() > 0;

      // update: staff only; the audit trail can only grow.
      allow update: if isStaff() && historyAppendOnly();

      // delete: staff only — used to vacate a person's OLD employee record when
      // they're promoted into a new one (one live record per person).
      allow delete: if isStaff();
    }

    // --- application scores (WS5 — one per application, staff-only) ---
    // Deliberately a SEPARATE collection from /applications, not a field on it.
    // WS1 already lets a candidate read their own /applications/{id} (to see
    // their own application status) — Firestore has no field-level read rules,
    // so a `score` field there would ride along on that same read and hand
    // every candidate their own match score, which CLAUDE.md's R3 test
    // explicitly forbids ("Candidate reads their own match score → Blocked —
    // internal to HR"). No read path exists here for anyone but staff.
    match /applicationScores/{applicationId} {
      allow read: if isStaff();
      allow create: if isStaff() && positionAvailable(request.resource.data.positionId);
      allow update: if isStaff() && positionAvailable(resource.data.positionId)
        && request.resource.data.positionId == resource.data.positionId;
      allow delete: if deletingPosition(resource.data.positionId);
    }

    // --- CV validation rejections (WS3) — demo evidence, immutable ---
    // A signed-in user logs only their OWN rejection (their own uid on the
    // entry); staff read the whole collection to see the gate is working.
    // Never updated or deleted — it's a record of what happened, not state.
    match /validation_logs/{id} {
      allow read: if isStaff();
      allow create: if optionalPositionAvailable(request.resource.data) && signedIn() && request.resource.data.submittedByUid == request.auth.uid;
      allow update: if false;
      allow delete: if deletingPosition(resource.data.positionId);
    }

    // --- in-app notifications (WS1 rejection notice, WS6 stage/offer/mention pings) ---
    // Addressed to one recipient (toUid); only staff ever create one (a candidate
    // has no one else in this app to notify); only the recipient may read/mark
    // their own read, and only the `read` field may ever change. Recruiters can
    // read/delete position-linked notices while that position is being deleted.
    match /notifications/{id} {
      allow read: if (signedIn() && resource.data.toUid == request.auth.uid)
        || deletingPosition(resource.data.get('positionId', ''));
      allow create: if isStaff() && optionalPositionAvailable(request.resource.data);
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if deletingPosition(resource.data.positionId);
    }

    // Anything not matched above is denied by default.
  }
}
