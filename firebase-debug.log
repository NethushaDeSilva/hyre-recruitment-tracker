[debug] [2026-09-21T06:44:19.989Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/hyre-127ed/rulesets {"name":"projects/hyre-127ed/rulesets/631913b1-fa52-4a7c-8468-405394f4f528","source":{"files":[{"content":"rules_version = '2';\r\n\r\n// Hyre Firestore security rules — FULL LOCKDOWN.\r\n//\r\n// Design principles:\r\n//  1. Nothing is readable or writable without being signed in.\r\n//  2. A user's role (users/{uid}.role) is the basis for every permission — so a\r\n//     user must NEVER be able to grant themselves a staff role. Self-serve\r\n//     accounts are always Candidates; staff roles are provisioned out-of-band\r\n//     (Firebase console or scripts/provision-staff.mjs) and can't change here.\r\n//  3. WS1 identity split: a person's CV/profile lives ONCE in /candidates\r\n//     (keyed by email); each vacancy they apply to is its own /applications\r\n//     doc. Applicants can create only THEIR OWN application, only into\r\n//     \"applied\" — no self-promotion to hired, no forged review data.\r\n//  4. Staff writes are gated by STAGE OWNERSHIP (mirrors src/lib/stages.js) and\r\n//     the audit trail (history[]) is append-only — entries can never be\r\n//     removed or truncated, so a rejection can't be quietly erased.\r\n//  5. Applicants read only their own rows (by uid or verified email); staff read\r\n//     the whole collection. The client MUST constrain candidate list queries to\r\n//     match (see src/data/store.js).\r\n//\r\n// NOTE: comments[] is intentionally staff-mutable (the product lets a reviewer\r\n// delete their own note before confirming a move); rules can't cheaply prove\r\n// which array element a caller removed. history[] is the tamper-evident record.\r\n\r\nservice cloud.firestore {\r\n  match /databases/{database}/documents {\r\n\r\n    function signedIn() {\r\n      return request.auth != null;\r\n    }\r\n\r\n    // The requester's role, read from their profile doc (\"\" if none).\r\n    function myRole() {\r\n      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))\r\n        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role\r\n        : \"\";\r\n    }\r\n    function isStaff() {\r\n      return myRole() in ['HR', 'Interviewer', 'Management'];\r\n    }\r\n    function isRecruiter() {\r\n      return myRole() in ['HR', 'Management'];\r\n    }\r\n\r\n    // A deletion lock closes the vacancy before any dependent rows are removed.\r\n    function positionAvailable(id) {\r\n      return exists(/databases/$(database)/documents/positions/$(id))\r\n        && !get(/databases/$(database)/documents/positions/$(id)).data.get('deleting', false);\r\n    }\r\n    function deletingPosition(id) {\r\n      return isRecruiter()\r\n        && exists(/databases/$(database)/documents/positions/$(id))\r\n        && get(/databases/$(database)/documents/positions/$(id)).data.get('deleting', false);\r\n    }\r\n    function optionalPositionAvailable(data) {\r\n      return data.get('positionId', '') == '' || positionAvailable(data.positionId);\r\n    }\r\n\r\n    function newPositionClaim(id) {\r\n      let data = request.resource.data;\r\n      let code = data.identityCode;\r\n      let number = data.identitySequence;\r\n      return code is string && code.matches('^[A-Z0-9]{1,5}$')\r\n        && number is int && number > 0\r\n        && id == code + '-' + (number < 10 ? '0' : '') + string(number)\r\n        && getAfter(/databases/$(database)/documents/positionSequences/$(code)).data.next == number\r\n        && number == (exists(/databases/$(database)/documents/positionSequences/$(code))\r\n          ? get(/databases/$(database)/documents/positionSequences/$(code)).data.next : 0) + 1;\r\n    }\r\n\r\n    match /positionSequences/{code} {\r\n      allow read: if isStaff();\r\n      allow create: if isRecruiter() && code.matches('^[A-Z0-9]{1,5}$')\r\n        && request.resource.data.keys().hasOnly(['next']) && request.resource.data.next == 1;\r\n      allow update: if isRecruiter() && request.resource.data.keys().hasOnly(['next'])\r\n        && request.resource.data.next is int && request.resource.data.next == resource.data.next + 1;\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Permanent identity registry. The full final vacancy survives deletion here.\r\n    match /positionArchive/{id} {\r\n      allow read: if isStaff();\r\n      allow create: if isRecruiter() && (\r\n        (newPositionClaim(id) && request.resource.data.recordState == 'Active'\r\n          && getAfter(/databases/$(database)/documents/positions/$(id)).data.identitySequence == request.resource.data.identitySequence)\r\n        || (deletingPosition(id) && request.resource.data.recordState == 'Deleted'));\r\n      allow update: if deletingPosition(id) && request.resource.data.recordState == 'Deleted';\r\n      allow delete: if false;\r\n    }\r\n\r\n    // Which role owns (may advance/reject a candidate sitting in) a stage.\r\n    // Mirrors STAGES[...].owner in src/lib/stages.js.\r\n    function stageOwner(stage) {\r\n      return stage in ['applied', 'screening', 'hold'] ? 'HR'\r\n           : stage in ['dept', 'interview', 'interview2'] ? 'Interviewer'\r\n           : stage == 'final' ? 'Management'\r\n           : ''; // hired / rejected are terminal — no owner\r\n    }\r\n    // May the caller act on a candidate currently in `stage`?\r\n    // Management can act on any stage; otherwise the caller must own it.\r\n    function ownsStage(stage) {\r\n      return myRole() == 'Management' || myRole() == stageOwner(stage);\r\n    }\r\n\r\n    // history[] may only grow — never shrink or be dropped. Tolerates docs that\r\n    // have no history field yet (older seed data).\r\n    function historyAppendOnly() {\r\n      return !('history' in resource.data)\r\n        || (('history' in request.resource.data)\r\n            && request.resource.data.history.size() >= resource.data.history.size());\r\n    }\r\n\r\n    function activeCrossApplication(a) {\r\n      return !(a.stage in ['rejected', 'withdrawn', 'hired'])\r\n        && !(a.get('status', '') in ['Rejected', 'Withdrawn', 'Hired', 'rejected', 'withdrawn', 'hired']);\r\n    }\r\n    function validCrossRejection() {\r\n      let old = resource.data;\r\n      let next = request.resource.data;\r\n      let audit = next.crossRejection;\r\n      let sourcePath = /databases/$(database)/documents/applications/$(audit.sourceApplicationId);\r\n      let source = get(sourcePath).data;\r\n      let comments = old.get('comments', []);\r\n      let history = old.get('history', []);\r\n      let feedback = next.comments[comments.size()];\r\n      let event = next.history[history.size()];\r\n      return myRole() in ['HR', 'Interviewer']\r\n        && activeCrossApplication(old) && activeCrossApplication(source)\r\n        && source.stage in ['screening', 'dept', 'interview', 'interview2', 'final']\r\n        && source.personId is string && source.personId.size() > 0\r\n        && source.personId == old.personId && audit.personId == old.personId\r\n        && source.positionId != old.positionId && positionAvailable(source.positionId)\r\n        && getAfter(sourcePath).data == source\r\n        && next.diff(old).affectedKeys().hasOnly(['stage', 'status', 'comments', 'history', 'rejection', 'crossRejection'])\r\n        && next.stage == 'rejected'\r\n        && (!('status' in old) ? !('status' in next) : next.status == 'Rejected')\r\n        && audit.keys().hasOnly(['sourceApplicationId', 'personId', 'byUid', 'at', 'committedAt'])\r\n        && audit.byUid == request.auth.uid && audit.committedAt == request.time && audit.at is int\r\n        && feedback.keys().hasOnly(['byUid', 'by', 'byRole', 'at', 'text', 'score', 'stage', 'sourceApplicationId', 'type'])\r\n        && feedback.byUid == request.auth.uid && feedback.byRole == myRole()\r\n        && feedback.at == audit.at && feedback.stage == old.stage\r\n        && feedback.type == 'cross_reject' && feedback.sourceApplicationId == audit.sourceApplicationId\r\n        && feedback.text is string && feedback.text.matches('[\\\\s\\\\S]*[^\\\\s][\\\\s\\\\S]*')\r\n        && feedback.score is number && feedback.score >= 0 && feedback.score <= 100\r\n        && next.comments == comments.concat([feedback])\r\n        && next.history == history.concat([event])\r\n        && event == {'byUid': feedback.byUid, 'by': feedback.by, 'byRole': feedback.byRole, 'at': feedback.at,\r\n          'type': 'reject', 'from': old.stage, 'to': 'rejected', 'reason': 'Candidate chose another position',\r\n          'comment': feedback.text, 'score': feedback.score, 'sourceApplicationId': audit.sourceApplicationId}\r\n        && next.rejection == {'byUid': feedback.byUid, 'by': feedback.by, 'byRole': feedback.byRole, 'at': feedback.at,\r\n          'reason': 'Candidate chose another position', 'comment': feedback.text, 'score': feedback.score, 'stage': old.stage};\r\n    }\r\n\r\n    function validPreferenceRecord() {\r\n      let p = request.resource.data;\r\n      let source = get(/databases/$(database)/documents/applications/$(p.sourceApplicationId)).data;\r\n      return myRole() == 'HR'\r\n        && p.keys().hasOnly(['personId','sourceApplicationId','choice','selectedApplicationId','selectedPositionTitle','applicationIds','byUid','by','at','note','createdAt'])\r\n        && p.byUid == request.auth.uid && p.by is string && p.at is int\r\n        && p.createdAt == request.time && p.note is string\r\n        && p.personId is string && p.personId.size() > 0 && source.personId == p.personId\r\n        && activeCrossApplication(source) && source.stage in ['screening','dept','interview','interview2','final']\r\n        && positionAvailable(source.positionId)\r\n        && p.applicationIds is list && p.applicationIds.size() >= 2 && p.applicationIds.size() <= 50\r\n        && p.sourceApplicationId in p.applicationIds\r\n        && p.choice in ['both','one','undecided']\r\n        && (p.choice != 'one' ? p.selectedApplicationId == '' : (\r\n          p.selectedApplicationId in p.applicationIds\r\n          && getAfter(/databases/$(database)/documents/applications/$(p.selectedApplicationId)).data.personId == p.personId\r\n          && activeCrossApplication(getAfter(/databases/$(database)/documents/applications/$(p.selectedApplicationId)).data)));\r\n    }\r\n    function validPreferenceWithdrawal(id) {\r\n      let old = resource.data;\r\n      let next = request.resource.data;\r\n      let event = next.withdrawal;\r\n      let path = /databases/$(database)/documents/candidatePreferences/$(event.preferenceId);\r\n      let preference = getAfter(path).data;\r\n      let kept = getAfter(/databases/$(database)/documents/applications/$(preference.selectedApplicationId)).data;\r\n      return myRole() == 'HR' && !exists(path)\r\n        && preference.choice == 'one' && preference.byUid == request.auth.uid\r\n        && preference.personId == old.personId && kept.personId == old.personId\r\n        && id in preference.applicationIds && id != preference.selectedApplicationId\r\n        && kept.positionId != old.positionId && activeCrossApplication(kept)\r\n        && activeCrossApplication(old) && next.stage == 'withdrawn'\r\n        && next.diff(old).affectedKeys().hasOnly(['stage','status','withdrawal','history'])\r\n        && (!('status' in old) ? !('status' in next) : next.status == 'Withdrawn')\r\n        && event == {'type':'withdraw','from':old.stage,'to':'withdrawn','reason':'Candidate preference',\r\n          'comment':preference.note,'preferenceId':event.preferenceId,'selectedApplicationId':preference.selectedApplicationId,\r\n          'byUid':preference.byUid,'by':preference.by,'byRole':'HR','at':preference.at}\r\n        && next.history == old.get('history', []).concat([event]);\r\n    }\r\n    match /candidatePreferences/{id} {\r\n      allow read: if isStaff();\r\n      allow create: if validPreferenceRecord();\r\n      allow update, delete: if false;\r\n    }\r\n\r\n    // --- user profiles ---\r\n    match /users/{uid} {\r\n      allow read: if signedIn();\r\n      // Create your own profile as a Candidate only. (Staff docs are provisioned\r\n      // out-of-band, so this create path is never used for staff.)\r\n      allow create: if signedIn() && request.auth.uid == uid\r\n                    && request.resource.data.role == 'Candidate';\r\n      // Update your own profile, but you can NEVER change your own role. Your\r\n      // readable User ID (userId) is write-ONCE: it may be minted when absent\r\n      // (the app self-heals it on first sign-in) but can never be altered after.\r\n      // WS8 §8.1/§8.3: `domain`/`levels` (interviewer specialisation) live on\r\n      // this doc rather than a separate `interviewers` collection (CLAUDE.md\r\n      // WS8 §8.3 deviation note) — self-write is allowed the same way name/\r\n      // avatarColor/title already are; nothing about them is security-critical\r\n      // the way `role` is, so they don't need their own narrower rule.\r\n      allow update: if signedIn() && request.auth.uid == uid\r\n                    && request.resource.data.role == resource.data.role\r\n                    && (!('userId' in resource.data)\r\n                        || request.resource.data.userId == resource.data.userId);\r\n      allow delete: if false;\r\n    }\r\n\r\n    // --- WS8 declared availability (one per staff member, self-declared) ---\r\n    // A person's own schedule claim — never inferred, never written by anyone\r\n    // but them. HR gets read-all (needed for the calendar view, §8.2a) but NOT\r\n    // write access to someone else's declaration: HR editing another person's\r\n    // availability would make it HR's claim wearing that person's name, which\r\n    // is indistinguishable from fabrication if it's ever wrong. HR's real\r\n    // power is the manual override on the BOOKING itself (§15), a separate,\r\n    // clearly-attributed action — not silently rewriting someone's calendar.\r\n    match /availability/{staffUid} {\r\n      allow read: if isStaff();\r\n      // isStaff() here, not just a uid match — a Candidate has an auth.uid\r\n      // too, and without this check they could write themselves a doc at\r\n      // availability/{their-own-uid}. Meaningless data (nothing ever reads a\r\n      // candidate's own uid out of this collection) but it's exactly the kind\r\n      // of stray write the rest of this ruleset is written to prevent by\r\n      // construction rather than by nothing-happens-to-read-it luck.\r\n      allow create, update: if isStaff() && request.auth.uid == staffUid\r\n                    && request.resource.data.timeZone is string\r\n                    && request.resource.data.timeZone.size() > 0;\r\n      allow delete: if false; // re-declaring supersedes; deleting would just create a false `unknown` gap\r\n    }\r\n\r\n    // --- Weekly availability TEMPLATE (a person's own recurring week) -----\r\n    // Deliberately a SEPARATE collection from /availability above — same\r\n    // ownership shape (read: any staff; write: only your own uid), but a\r\n    // different document shape (a permanent weekly template, not a dated\r\n    // declaration with an expiry), so it gets its own match block rather\r\n    // than overloading the one above with two incompatible schemas.\r\n    match /weeklyAvailability/{staffUid} {\r\n      allow read: if isStaff();\r\n      allow create, update: if isStaff() && request.auth.uid == staffUid\r\n                    && request.resource.data.updatedByUid == staffUid\r\n                    && request.resource.data.days is map;\r\n      allow delete: if false; // same reasoning as /availability — re-saving supersedes\r\n    }\r\n\r\n    // --- WS8 Part C interviews (automated requests + booked interviews) ---\r\n    // create: staff only (the assignment trigger or HR's manual override, §15\r\n    // — both run under a staff session; an Interviewer can trigger one too,\r\n    // since advancing a candidate out of an Interviewer-owned stage is a\r\n    // normal action for that role — see applications' ownsStage() precedent).\r\n    //\r\n    // READ and UPDATE's broad branch is isRecruiter() (HR/Management), NOT\r\n    // isStaff(). This was a real bug, found live: isStaff() includes the\r\n    // Interviewer role, so `isStaff() || (narrow interviewer-self check)`\r\n    // let isStaff() short-circuit true for ANY interviewer on ANY OTHER\r\n    // interviewer's request — the narrow branch below was correctly written\r\n    // but dead code, silently bypassed by the broad OR in front of it. An\r\n    // Interviewer must only ever touch a request where they ARE the current\r\n    // interviewerId, through the narrow, mechanically-constrained path — full\r\n    // staff-grade access to this collection belongs to HR/Management only.\r\n    //\r\n    // SECOND ENCOUNTER, 2026-09-19: the exact same isStaff() widening was\r\n    // proposed again, this time to satisfy commitInterviewChanges()'s\r\n    // unfiltered getDocs(collection(db,\"interviews\")) call in\r\n    // src/lib/interviewPersistence.js — its cross-position conflict check\r\n    // (bookingConflict) needs visibility into bookings that don't belong to\r\n    // the caller. Investigated whether the read could instead be scoped to\r\n    // where(\"interviewerId\",\"==\",request.auth.uid): it cannot, cleanly — see\r\n    // the dated note above the `interviews` match block below for why, and\r\n    // report this conversation for the two options put to the Product Owner.\r\n    // Do not re-propose isStaff() here a third time without reading this.\r\n    // update, isRecruiter(): full access — HR's override, marking completed.\r\n    // update, the currently-requested interviewer, responding to THEIR OWN\r\n    // pending request — exactly two shapes, nothing else:\r\n    //   ACCEPT   — only `status` changes, to 'confirmed'.\r\n    //   DECLINE  — mechanically advances via `rankedInfo`, a uid-KEYED map\r\n    //     written once at creation: rankedInfo[uid].nextUid says who follows\r\n    //     that person in the ranking (or null if nobody does). The new\r\n    //     interviewerId must equal rankedInfo[OLD interviewerId].nextUid —\r\n    //     the interviewer can only reveal a value someone else already wrote,\r\n    //     never name their own replacement.\r\n    //     IMPORTANT: this is deliberately a KEYED map lookup, not indexing\r\n    //     into rankedCandidates by position. An earlier version tried\r\n    //     `rankedCandidates[currentRankIndex].uid` and, verified LIVE against\r\n    //     these deployed rules, that did NOT actually constrain the write —\r\n    //     a forged reassignment to an arbitrary uid was wrongly allowed\r\n    //     (scratch-ws8/verify-cascade-rules.mjs documents the failing and\r\n    //     passing runs). Keyed map access mirrors the pattern this ruleset\r\n    //     already trusts elsewhere (myRole() reading a doc by uid) and was\r\n    //     re-verified live to correctly reject a forged value before this\r\n    //     shipped — do not revert to positional indexing.\r\n    //     A second live finding: BOTH rankedInfo[uid].nextUid AND\r\n    //     interviewerId use \"\" (never `null`) to mark \"nobody\" — comparing\r\n    //     either to `null` did not evaluate as a straightforward equality\r\n    //     check when tested live (top-level or nested; the exact cause\r\n    //     wasn't isolated further once removing `null` entirely fixed it\r\n    //     both places). A real Firebase uid is never \"\", so the sentinel can\r\n    //     never be mistaken for a real assignment. The app's own read layer\r\n    //     (mapInterviewDoc in store.js) converts \"\" back to `null` for\r\n    //     consumers — this sentinel is a rules-evaluation workaround, not a\r\n    //     concept that should leak into the rest of the codebase.\r\n    function scheduleRevisionAdvanced() {\r\n      let path = /databases/$(database)/documents/counters/interviewSchedule;\r\n      let before = exists(path) ? get(path).data.next : 0;\r\n      return getAfter(path).data.next == before + 1;\r\n    }\r\n    // 2026-09-19 — READ STAYS isRecruiter()-OR-SELF, NOT isStaff(). Investigated\r\n    // scoping commitInterviewChanges()'s unfiltered read (src/lib/interviewPersistence.js)\r\n    // to where(\"interviewerId\",\"==\",request.auth.uid) instead of widening this\r\n    // rule. Firestore requires an unfiltered collection query to be provably\r\n    // satisfied by the rule for EVERY possible returned document, so a scoped\r\n    // query only works if every legitimate read genuinely only ever needs the\r\n    // caller's own docs — and it doesn't: respondToInterviewRequest()'s DECLINE\r\n    // path also conflict-checks the PROPOSED NEXT interviewer (a different\r\n    // uid, read from the current request's own rankedInfo) before handing off,\r\n    // so the query needs a second party's bookings, not just the caller's own.\r\n    // A self-scoped query cannot return that document at all under a\r\n    // self-scoped rule. Reported to the Product Owner rather than widened\r\n    // silently a second time; see the two options above this match block.\r\n    match /interviews/{interviewId} {\r\n      allow read: if isRecruiter()\r\n        || (signedIn() && resource.data.interviewerId == request.auth.uid);\r\n      allow create: if isStaff() && scheduleRevisionAdvanced() && positionAvailable(request.resource.data.positionId);\r\n      allow update: if scheduleRevisionAdvanced() && positionAvailable(resource.data.positionId)\r\n        && request.resource.data.positionId == resource.data.positionId\r\n        && (isRecruiter()\r\n        || (signedIn() && resource.data.interviewerId == request.auth.uid\r\n            && resource.data.status == 'pending_confirmation'\r\n            && (\r\n                 (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])\r\n                  && request.resource.data.status == 'confirmed')\r\n                 ||\r\n                 (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'interviewerId', 'requestedAt', 'respondedBy'])\r\n                  && request.resource.data.respondedBy.size() == resource.data.respondedBy.size() + 1\r\n                  && (\r\n                       (resource.data.rankedInfo[resource.data.interviewerId].nextUid != ''\r\n                        && request.resource.data.interviewerId == resource.data.rankedInfo[resource.data.interviewerId].nextUid\r\n                        && request.resource.data.status == 'pending_confirmation')\r\n                       ||\r\n                       (request.resource.data.interviewerId == ''\r\n                        && request.resource.data.status == 'needs_attention')\r\n                     )\r\n                 )\r\n               )));\r\n      allow delete: if deletingPosition(resource.data.positionId);\r\n    }\r\n\r\n    // --- positions ---\r\n    //  read:   any signed-in user\r\n    //  create: recruiters (HR is the recruitment authority; vacancies open directly)\r\n    //  update: recruiters may edit details/stages and change status (close/reopen)\r\n    //  delete: recruiters (HR owns the pipeline post role-swap; Management retained)\r\n    match /positions/{id} {\r\n      // Staff manage every status (draft/open/closed); anyone else may only\r\n      // read an Open vacancy directly by id — otherwise a candidate who knows\r\n      // or guesses a draft/closed position's id can read it despite never\r\n      // seeing it in any listing (WS1: \"draft and closed never leak\" — a\r\n      // client-side query filter alone doesn't enforce that, this does; CLAUDE.md\r\n      // 6.7 R6).\r\n      allow read: if isStaff() || (signedIn() && resource.data.status == 'Open');\r\n      allow create: if isRecruiter() && newPositionClaim(id)\r\n        && !exists(/databases/$(database)/documents/positionArchive/$(id))\r\n        && getAfter(/databases/$(database)/documents/positionArchive/$(id)).data.recordState == 'Active';\r\n      allow update: if !resource.data.get('deleting', false)\r\n        && request.resource.data.get('identityCode', '') == resource.data.get('identityCode', '')\r\n        && request.resource.data.get('identitySequence', 0) == resource.data.get('identitySequence', 0)\r\n        && (isRecruiter()\r\n        // Any staff member may close out a requisition as part of hiring a\r\n        // candidate into it (hireCandidate() in src/data/store.js) — the stage\r\n        // whose owner triggers the \"hired\" transition isn't always HR/Management\r\n        // (e.g. a short pipeline where an Interviewer-owned stage feeds straight\r\n        // into Hired). Scoped tightly: only hiredCount/status may change,\r\n        // hiredCount only ever advances by exactly one, and status may only\r\n        // become \"Closed\" — never anything else — through this path.\r\n        || (isStaff()\r\n            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiredCount', 'status'])\r\n            && request.resource.data.hiredCount == resource.data.get('hiredCount', 0) + 1\r\n            && (request.resource.data.status == resource.data.status || request.resource.data.status == 'Closed')));\r\n      allow delete: if isRecruiter() && resource.data.get('deleting', false)\r\n        && getAfter(/databases/$(database)/documents/positionArchive/$(id)).data.recordState == 'Deleted';\r\n    }\r\n\r\n    // --- sequence counters (e.g. counters/candidates.next) ---\r\n    // Hands out unique, monotonically-increasing candidate numbers. Any signed-in\r\n    // user may read it and claim the next number, but the value can only ever go\r\n    // UP (and only the `next` field exists), so numbers can't be reused or forged\r\n    // downward. Uniqueness is guaranteed by the client using a transaction.\r\n    match /counters/{id} {\r\n      allow read: if signedIn();\r\n      allow create: if signedIn() && (id != 'interviewSchedule' || (isStaff() && request.resource.data.next == 1)) && (id != 'positionsV2' || (isRecruiter() && request.resource.data.next == 1))\r\n        && request.resource.data.keys().hasOnly(['next'])\r\n        && request.resource.data.next is int\r\n        && request.resource.data.next >= 1;\r\n      allow update: if signedIn() && (id != 'interviewSchedule' || (isStaff() && request.resource.data.next == resource.data.next + 1)) && (id != 'positionsV2' || (isRecruiter() && request.resource.data.next == resource.data.next + 1))\r\n        && request.resource.data.keys().hasOnly(['next'])\r\n        && request.resource.data.next is int\r\n        && request.resource.data.next > resource.data.next;\r\n      allow delete: if false;\r\n    }\r\n\r\n    // --- candidates (IDENTITY — one per person, keyed on lowercased email) ---\r\n    // WS1: a person's email, phone, CV and parsed profile live ONCE here, shared\r\n    // across every vacancy they apply to (see /applications below). This is\r\n    // deliberately permissive on the `email` field itself (mirrors the pre-split\r\n    // rule, which never cross-checked the typed email against the verified\r\n    // auth email either) — `submittedByUid`, when present, is the real anchor.\r\n    match /candidates/{id} {\r\n      // read: staff → all; a person → only their own identity record.\r\n      // The `!exists()` clause is load-bearing, not defensive dressing: a\r\n      // FIRST-TIME applicant's own upsertIdentityInTx() does a tx.get() on\r\n      // this exact path BEFORE the document exists (check-before-create), and\r\n      // without it `resource.data.submittedByUid` dereferences a null\r\n      // `resource` — Firestore treats that evaluation error as denied, which\r\n      // blocked every brand-new candidate's very first application outright\r\n      // (found live; existing candidate docs all predate this path or were\r\n      // created by staff, whose isStaff() branch never touches `resource`).\r\n      // Safe to allow unconditionally: a nonexistent document has no data to\r\n      // leak.\r\n      allow read: if isStaff()\r\n        || (signedIn() && (\r\n              !exists(/databases/$(database)/documents/candidates/$(id))\r\n              || resource.data.submittedByUid == request.auth.uid\r\n              || resource.data.email == request.auth.token.email));\r\n\r\n      // create: staff (HR quick-add, WS5 email intake) or a signed-in person\r\n      // creating their OWN identity — if submittedByUid is set at all, it must\r\n      // be their own uid, so nobody can create an identity claiming to be\r\n      // someone else's account.\r\n      allow create: if isStaff()\r\n        || (signedIn()\r\n            && (!('submittedByUid' in request.resource.data)\r\n                || request.resource.data.submittedByUid == request.auth.uid));\r\n\r\n      // update: staff (enrich/correct a profile, WS5 merge) or the owning\r\n      // person (WS4's \"confirm what we read from your CV\" step) — the anchors\r\n      // (email, candidateId) can never change once minted.\r\n      allow update: if isStaff()\r\n        || (signedIn()\r\n            && (resource.data.submittedByUid == request.auth.uid\r\n                || resource.data.email == request.auth.token.email)\r\n            && request.resource.data.email == resource.data.email\r\n            && request.resource.data.candidateId == resource.data.candidateId);\r\n\r\n      // delete: never — identity persists regardless of how many applications\r\n      // come and go, or whether the person is eventually hired.\r\n      allow delete: if false;\r\n    }\r\n\r\n    // --- applications (PIPELINE — one per person per vacancy) ---\r\n    match /applications/{id} {\r\n      // read: staff → all; applicant → only their own (by uid or verified email).\r\n      allow read: if isStaff()\r\n        || (signedIn() && (\r\n              resource.data.submittedByUid == request.auth.uid\r\n              || resource.data.email == request.auth.token.email));\r\n\r\n      // create: staff add anyone; an applicant creates only their own\r\n      // application, only into \"applied\", with no forged review payload.\r\n      allow create: if positionAvailable(request.resource.data.positionId) && (isStaff()\r\n        || (signedIn()\r\n            && request.resource.data.submittedByUid == request.auth.uid\r\n            && request.resource.data.stage == 'applied'\r\n            && request.resource.data.source == 'Self-applied'\r\n            && (!('comments' in request.resource.data)\r\n                || request.resource.data.comments.size() == 0)));\r\n\r\n      // update: staff only, history append-only, and either\r\n      //   (a) no stage change  → a comment / profile edit (any staff), or\r\n      //   (b) a stage change   → the caller must own the current stage, or\r\n      //   (c) HR reinstating a rejected candidate from the talent pool\r\n      //       (rejected → applied). ONLY HR may reconsider — not Management.\r\n      allow update: if positionAvailable(resource.data.positionId)\r\n        && request.resource.data.positionId == resource.data.positionId\r\n        && request.resource.data.get('personId', '') == resource.data.get('personId', '')\r\n        && isStaff() && historyAppendOnly()\r\n        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['crossRejection'])\r\n        && (request.resource.data.diff(resource.data).affectedKeys().hasAny(['withdrawal'])\r\n          || (request.resource.data.stage == 'withdrawn' && resource.data.stage != 'withdrawn')\r\n          ? validPreferenceWithdrawal(id)\r\n          : (request.resource.data.stage == resource.data.stage\r\n            || (resource.data.stage != 'withdrawn' && ownsStage(resource.data.stage))\r\n            || (resource.data.stage == 'rejected' && request.resource.data.stage == 'applied' && myRole() == 'HR')));\r\n\r\n      // delete: explicit position cleanup, or as part of a HIRE transfer — a stage owner (or Management)\r\n      // removes the application the instant it's written into `employees`.\r\n      // Rejected applications otherwise remain in the talent pool.\r\n      allow delete: if deletingPosition(resource.data.positionId) || (isStaff()\r\n        && !(resource.data.stage in ['rejected', 'withdrawn'])\r\n        && ownsStage(resource.data.stage));\r\n    }\r\n\r\n    // --- employees (HIRED people) ---\r\n    // The moment an application reaches \"hired\" it's MOVED out of /applications\r\n    // and written here as a full snapshot (see hireCandidate() in\r\n    // src/data/store.js), keyed by a readable employee ID (e.g.\r\n    // employees/SE-SNE-0001). The person's /candidates identity record is left\r\n    // untouched — it isn't deleted just because they were hired. Same read\r\n    // scoping as applications: staff see everyone; a person sees only their own.\r\n    match /employees/{id} {\r\n      allow read: if isStaff()\r\n        || (signedIn() && (\r\n              resource.data.submittedByUid == request.auth.uid\r\n              || resource.data.email == request.auth.token.email));\r\n\r\n      // create: staff only, and only a well-formed HIRED record (this is the\r\n      // destination of a hire — never a self-serve write).\r\n      allow create: if isStaff() && positionAvailable(request.resource.data.positionId)\r\n        && request.resource.data.stage == 'hired'\r\n        && request.resource.data.employeeId is string\r\n        && request.resource.data.employeeId.size() > 0;\r\n\r\n      // update: staff only; the audit trail can only grow.\r\n      allow update: if isStaff() && historyAppendOnly();\r\n\r\n      // delete: staff only — used to vacate a person's OLD employee record when\r\n      // they're promoted into a new one (one live record per person).\r\n      allow delete: if isStaff();\r\n    }\r\n\r\n    // --- application scores (WS5 — one per application, staff-only) ---\r\n    // Deliberately a SEPARATE collection from /applications, not a field on it.\r\n    // WS1 already lets a candidate read their own /applications/{id} (to see\r\n    // their own application status) — Firestore has no field-level read rules,\r\n    // so a `score` field there would ride along on that same read and hand\r\n    // every candidate their own match score, which CLAUDE.md's R3 test\r\n    // explicitly forbids (\"Candidate reads their own match score → Blocked —\r\n    // internal to HR\"). No read path exists here for anyone but staff.\r\n    match /applicationScores/{applicationId} {\r\n      allow read: if isStaff();\r\n      allow create: if isStaff() && positionAvailable(request.resource.data.positionId);\r\n      allow update: if isStaff() && positionAvailable(resource.data.positionId)\r\n        && request.resource.data.positionId == resource.data.positionId;\r\n      allow delete: if deletingPosition(resource.data.positionId);\r\n    }\r\n\r\n    // --- CV validation rejections (WS3) — demo evidence, immutable ---\r\n    // A signed-in user logs only their OWN rejection (their own uid on the\r\n    // entry); staff read the whole collection to see the gate is working.\r\n    // Never updated or deleted — it's a record of what happened, not state.\r\n    match /validation_logs/{id} {\r\n      allow read: if isStaff();\r\n      allow create: if optionalPositionAvailable(request.resource.data) && signedIn() && request.resource.data.submittedByUid == request.auth.uid;\r\n      allow update: if false;\r\n      allow delete: if deletingPosition(resource.data.positionId);\r\n    }\r\n\r\n    // --- in-app notifications (WS1 rejection notice, WS6 stage/offer/mention pings) ---\r\n    // Addressed to one recipient (toUid); only staff ever create one (a candidate\r\n    // has no one else in this app to notify); only the recipient may read/mark\r\n    // their own read, and only the `read` field may ever change. Recruiters can\r\n    // read/delete position-linked notices while that position is being deleted.\r\n    match /notifications/{id} {\r\n      allow read: if (signedIn() && resource.data.toUid == request.auth.uid)\r\n        || deletingPosition(resource.data.get('positionId', ''));\r\n      allow create: if isStaff() && optionalPositionAvailable(request.resource.data);\r\n      allow update: if signedIn() && resource.data.toUid == request.auth.uid\r\n        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);\r\n      allow delete: if deletingPosition(resource.data.positionId);\r\n    }\r\n\r\n    // Anything not matched above is denied by default.\r\n  }\r\n}\r\n","name":"firestore.rules"}]},"createTime":"2026-09-21T06:44:21.086159Z","metadata":{"services":["cloud.firestore"]}}
