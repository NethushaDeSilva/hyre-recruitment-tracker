rules_version = '2';

// Hyre Firestore security rules — FULL LOCKDOWN.
//
// Design principles:
//  1. Nothing is readable or writable without being signed in.
//  2. A user's role (users/{uid}.role) is the basis for every permission — so a
//     user must NEVER be able to grant themselves a staff role. Self-serve
//     accounts are always Candidates; staff roles are provisioned out-of-band
//     (Firebase console or scripts/provision-staff.mjs) and can't change here.
//  3. WS1 identity split: a person's CV/profile lives ONCE in /candidates
//     (keyed by email); each vacancy they apply to is its own /applications
//     doc. Applicants can create only THEIR OWN application, only into
//     "applied" — no self-promotion to hired, no forged review data.
//  4. Staff writes are gated by STAGE OWNERSHIP (mirrors src/lib/stages.js) and
//     the audit trail (history[]) is append-only — entries can never be
//     removed or truncated, so a rejection can't be quietly erased.
//  5. Applicants read only their own rows (by uid or verified email); staff read
//     the whole collection. The client MUST constrain candidate list queries to
//     match (see src/data/store.js).
//
// NOTE: comments[] is intentionally staff-mutable (the product lets a reviewer
// delete their own note before confirming a move); rules can't cheaply prove
// which array element a caller removed. history[] is the tamper-evident record.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // The requester's role, read from their profile doc ("" if none).
    function myRole() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : "";
    }
    function isStaff() {
      return myRole() in ['HR', 'Interviewer', 'Management'];
    }
    function isRecruiter() {
      return myRole() in ['HR', 'Management'];
    }

    // Which role owns (may advance/reject a candidate sitting in) a stage.
    // Mirrors STAGES[...].owner in src/lib/stages.js.
    function stageOwner(stage) {
      return stage in ['applied', 'screening', 'hold'] ? 'HR'
           : stage in ['dept', 'interview', 'interview2'] ? 'Interviewer'
           : stage == 'final' ? 'Management'
           : ''; // hired / rejected are terminal — no owner
    }
    // May the caller act on a candidate currently in `stage`?
    // Management can act on any stage; otherwise the caller must own it.
    function ownsStage(stage) {
      return myRole() == 'Management' || myRole() == stageOwner(stage);
    }

    // history[] may only grow — never shrink or be dropped. Tolerates docs that
    // have no history field yet (older seed data).
    function historyAppendOnly() {
      return !('history' in resource.data)
        || (('history' in request.resource.data)
            && request.resource.data.history.size() >= resource.data.history.size());
    }

    // --- user profiles ---
    match /users/{uid} {
      allow read: if signedIn();
      // Create your own profile as a Candidate only. (Staff docs are provisioned
      // out-of-band, so this create path is never used for staff.)
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == 'Candidate';
      // Update your own profile, but you can NEVER change your own role. Your
      // readable User ID (userId) is write-ONCE: it may be minted when absent
      // (the app self-heals it on first sign-in) but can never be altered after.
      allow update: if signedIn() && request.auth.uid == uid
                    && request.resource.data.role == resource.data.role
                    && (!('userId' in resource.data)
                        || request.resource.data.userId == resource.data.userId);
      allow delete: if false;
    }

    // --- positions ---
    //  read:   any signed-in user
    //  create: recruiters (HR is the recruitment authority; vacancies open directly)
    //  update: recruiters may edit details/stages and change status (close/reopen)
    //  delete: recruiters (HR owns the pipeline post role-swap; Management retained)
    match /positions/{id} {
      // Staff manage every status (draft/open/closed); anyone else may only
      // read an Open vacancy directly by id — otherwise a candidate who knows
      // or guesses a draft/closed position's id can read it despite never
      // seeing it in any listing (WS1: "draft and closed never leak" — a
      // client-side query filter alone doesn't enforce that, this does; CLAUDE.md
      // 6.7 R6).
      allow read: if isStaff() || (signedIn() && resource.data.status == 'Open');
      allow create: if isRecruiter();
      allow update: if isRecruiter()
        // Any staff member may close out a requisition as part of hiring a
        // candidate into it (hireCandidate() in src/data/store.js) — the stage
        // whose owner triggers the "hired" transition isn't always HR/Management
        // (e.g. a short pipeline where an Interviewer-owned stage feeds straight
        // into Hired). Scoped tightly: only hiredCount/status may change,
        // hiredCount only ever advances by exactly one, and status may only
        // become "Closed" — never anything else — through this path.
        || (isStaff()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiredCount', 'status'])
            && request.resource.data.hiredCount == resource.data.get('hiredCount', 0) + 1
            && (request.resource.data.status == resource.data.status || request.resource.data.status == 'Closed'));
      allow delete: if isRecruiter();
    }

    // --- sequence counters (e.g. counters/candidates.next) ---
    // Hands out unique, monotonically-increasing candidate numbers. Any signed-in
    // user may read it and claim the next number, but the value can only ever go
    // UP (and only the `next` field exists), so numbers can't be reused or forged
    // downward. Uniqueness is guaranteed by the client using a transaction.
    match /counters/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next >= 1;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['next'])
        && request.resource.data.next is int
        && request.resource.data.next > resource.data.next;
      allow delete: if false;
    }

    // --- candidates (IDENTITY — one per person, keyed on lowercased email) ---
    // WS1: a person's email, phone, CV and parsed profile live ONCE here, shared
    // across every vacancy they apply to (see /applications below). This is
    // deliberately permissive on the `email` field itself (mirrors the pre-split
    // rule, which never cross-checked the typed email against the verified
    // auth email either) — `submittedByUid`, when present, is the real anchor.
    match /candidates/{id} {
      // read: staff → all; a person → only their own identity record.
      // The `!exists()` clause is load-bearing, not defensive dressing: a
      // FIRST-TIME applicant's own upsertIdentityInTx() does a tx.get() on
      // this exact path BEFORE the document exists (check-before-create), and
      // without it `resource.data.submittedByUid` dereferences a null
      // `resource` — Firestore treats that evaluation error as denied, which
      // blocked every brand-new candidate's very first application outright
      // (found live; existing candidate docs all predate this path or were
      // created by staff, whose isStaff() branch never touches `resource`).
      // Safe to allow unconditionally: a nonexistent document has no data to
      // leak.
      allow read: if isStaff()
        || (signedIn() && (
              !exists(/databases/$(database)/documents/candidates/$(id))
              || resource.data.submittedByUid == request.auth.uid
              || resource.data.email == request.auth.token.email));

      // create: staff (HR quick-add, WS5 email intake) or a signed-in person
      // creating their OWN identity — if submittedByUid is set at all, it must
      // be their own uid, so nobody can create an identity claiming to be
      // someone else's account.
      allow create: if isStaff()
        || (signedIn()
            && (!('submittedByUid' in request.resource.data)
                || request.resource.data.submittedByUid == request.auth.uid));

      // update: staff (enrich/correct a profile, WS5 merge) or the owning
      // person (WS4's "confirm what we read from your CV" step) — the anchors
      // (email, candidateId) can never change once minted.
      allow update: if isStaff()
        || (signedIn()
            && (resource.data.submittedByUid == request.auth.uid
                || resource.data.email == request.auth.token.email)
            && request.resource.data.email == resource.data.email
            && request.resource.data.candidateId == resource.data.candidateId);

      // delete: never — identity persists regardless of how many applications
      // come and go, or whether the person is eventually hired.
      allow delete: if false;
    }

    // --- applications (PIPELINE — one per person per vacancy) ---
    match /applications/{id} {
      // read: staff → all; applicant → only their own (by uid or verified email).
      allow read: if isStaff()
        || (signedIn() && (
              resource.data.submittedByUid == request.auth.uid
              || resource.data.email == request.auth.token.email));

      // create: staff add anyone; an applicant creates only their own
      // application, only into "applied", with no forged review payload.
      // emailVerified (signup email validation layer 2) must equal the
      // SERVER-issued claim on the caller's own ID token, never a value the
      // client just hands us — otherwise a candidate could simply write
      // emailVerified:true regardless of truth, same anti-forgery reasoning
      // as applicationScores being staff-write-only (5.8/R3).
      allow create: if isStaff()
        || (signedIn()
            && request.resource.data.submittedByUid == request.auth.uid
            && request.resource.data.stage == 'applied'
            && request.resource.data.source == 'Self-applied'
            && request.resource.data.emailVerified == request.auth.token.email_verified
            && (!('comments' in request.resource.data)
                || request.resource.data.comments.size() == 0));

      // update: staff only, history append-only, and either
      //   (a) no stage change  → a comment / profile edit (any staff), or
      //   (b) a stage change   → the caller must own the current stage, or
      //   (c) HR reinstating a rejected candidate from the talent pool
      //       (rejected → applied). ONLY HR may reconsider — not Management.
      allow update: if isStaff()
        && historyAppendOnly()
        && (
             request.resource.data.stage == resource.data.stage
             || ownsStage(resource.data.stage)
             || (resource.data.stage == 'rejected'
                 && request.resource.data.stage == 'applied'
                 && myRole() == 'HR')
           );

      // delete: only as part of a HIRE transfer — a stage owner (or Management)
      // removes the application the instant it's written into `employees`. A
      // REJECTED application can NEVER be deleted (the talent pool is permanent).
      allow delete: if isStaff()
        && resource.data.stage != 'rejected'
        && ownsStage(resource.data.stage);
    }

    // --- employees (HIRED people) ---
    // The moment an application reaches "hired" it's MOVED out of /applications
    // and written here as a full snapshot (see hireCandidate() in
    // src/data/store.js), keyed by a readable employee ID (e.g.
    // employees/SE-SNE-0001). The person's /candidates identity record is left
    // untouched — it isn't deleted just because they were hired. Same read
    // scoping as applications: staff see everyone; a person sees only their own.
    match /employees/{id} {
      allow read: if isStaff()
        || (signedIn() && (
              resource.data.submittedByUid == request.auth.uid
              || resource.data.email == request.auth.token.email));

      // create: staff only, and only a well-formed HIRED record (this is the
      // destination of a hire — never a self-serve write).
      allow create: if isStaff()
        && request.resource.data.stage == 'hired'
        && request.resource.data.employeeId is string
        && request.resource.data.employeeId.size() > 0;

      // update: staff only; the audit trail can only grow.
      allow update: if isStaff() && historyAppendOnly();

      // delete: staff only — used to vacate a person's OLD employee record when
      // they're promoted into a new one (one live record per person).
      allow delete: if isStaff();
    }

    // --- application scores (WS5 — one per application, staff-only) ---
    // Deliberately a SEPARATE collection from /applications, not a field on it.
    // WS1 already lets a candidate read their own /applications/{id} (to see
    // their own application status) — Firestore has no field-level read rules,
    // so a `score` field there would ride along on that same read and hand
    // every candidate their own match score, which CLAUDE.md's R3 test
    // explicitly forbids ("Candidate reads their own match score → Blocked —
    // internal to HR"). No read path exists here for anyone but staff.
    match /applicationScores/{applicationId} {
      allow read: if isStaff();
      allow create, update: if isStaff();
      allow delete: if false; // score history persists — never silently erased
    }

    // --- CV validation rejections (WS3) — demo evidence, immutable ---
    // A signed-in user logs only their OWN rejection (their own uid on the
    // entry); staff read the whole collection to see the gate is working.
    // Never updated or deleted — it's a record of what happened, not state.
    match /validation_logs/{id} {
      allow read: if isStaff();
      allow create: if signedIn() && request.resource.data.submittedByUid == request.auth.uid;
      allow update, delete: if false;
    }

    // --- in-app notifications (WS1 rejection notice, WS6 stage/offer/mention pings) ---
    // Addressed to one recipient (toUid); only staff ever create one (a candidate
    // has no one else in this app to notify); only the recipient may read/mark
    // their own read, and only the `read` field may ever change.
    match /notifications/{id} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if isStaff();
      allow update: if signedIn() && resource.data.toUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if false;
    }

    // Anything not matched above is denied by default.
  }
}
